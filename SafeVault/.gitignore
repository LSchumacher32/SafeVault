## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# Rider / ReSharper
.idea/
*.sln.iml
*.sln.rider

# User-specific files
*.user
*.rsuser
*.suo
*.userosscache
*.sln.docstates

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/

# Bin and Obj directories for all projects
bin/
obj/

# Output folder used by MSBuild
out/

# NuGet Packages
*.nupkg
*.snupkg

# NuGet Symbol Packages
*.snupkg

# NuGet Lock
packages.lock.json

# Package Manager Files
project.assets.json
project.nuget.cache

# Visual Studio cache/options directory
.vs/

# Visual Studio Code
.vscode/
*.code-workspace

# Rider/.ReSharper files
.idea/
.rider/

# Local database files
*.mdf
*.ldf
*.db
*.sqlite
*.sqlite3

# User-specific database backups
App_Data/

# Test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
*.trx
*.coverage
*.coveragexml

# Local publish output
PublishProfiles/
*.PublishSettings
*.pubxml
*.azurePubxml
*.pfx
*.publishsettings
web.config
web.*.config

# Local environment and secrets
.env
.env.local
.env.*.local
.env.production.local
appsettings.local.json

# Keep .env.example for reference
!.env.example

# Private keys and certificates with private keys
*.pfx
*.pem
*.key
*.crt
!*.pem.example
!*.key.example

# IDE-specific files
.vscode/
.idea/
*.swp
*.swo
*~

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
desktop.ini

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# .NET specific
*.VisualState.xml
*.snap

# Diagnostic Reports
diagnostics/

# Persistent project settings
.vscode/settings.json

# CopilotSnapshots (automatically generated local snapshots)
.vs/CopilotSnapshots/
